# ---- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5

# ---- Supabase (Project Settings → API) ----------------------------------------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key, never the anon key

# ---- neatlogs (optional; unset = tracing disabled) -------------------------------
NEATLOGS_API_KEY=
NEATLOGS_TAGS=prod

# ---- Messaging --------------------------------------------------------------------
MESSAGING_PROVIDER=whatsapp        # whatsapp | telegram
RECIPIENT_PHONE=91XXXXXXXXXX       # country code + number, no plus sign

# Meta WhatsApp Cloud API (Meta for Developers → your app → WhatsApp → API Setup)
META_ACCESS_TOKEN=EAAG...          # permanent System User token
META_PHONE_NUMBER_ID=1234567890
META_APP_SECRET=abcdef...          # App Settings → Basic → App Secret
META_VERIFY_TOKEN=choose-a-long-random-string
META_API_VERSION=v21.0

# Telegram fallback (BotFather token; chat id from https://api.telegram.org/bot<token>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=choose-another-long-random-string

# ---- Scraper tuning (defaults shown) ----------------------------------------------
MIN_VALUE_INR=600000
PORTAL_TIMEOUT_SECONDS=600
REQUEST_DELAY_SECONDS=1.5
MAX_PAGES_PER_PORTAL=40
MAX_CANDIDATES_PER_PORTAL=60
VERIFY_TLS=false                    # many NIC portals have broken certificate chains
